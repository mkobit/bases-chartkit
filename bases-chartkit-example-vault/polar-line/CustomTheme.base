properties:
  note.Load:
    displayName: Load
  note.Server:
    displayName: Server
  note.Time:
    displayName: Time
views:
  - type: polar-line-chart
    name: Server load (polar line, vintage theme)
    xAxisProp: note.Time
    valueProp: note.Load
    seriesProp: note.Server
    showLegend: true
    legendPosition: "bottom"
    theme: "Vintage"
    title: "Server load across time of day"
    description: "Vintage palette variant of the same time x server polar line."
    filters:
      and:
        - file.folder == "polar-line/notes"
