properties:
  note.Charisma:
    displayName: Charisma
  note.Class:
    displayName: Class
  note.Constitution:
    displayName: Constitution
  note.Dexterity:
    displayName: Dexterity
  note.Intelligence:
    displayName: Intelligence
  note.Strength:
    displayName: Strength
  note.Wisdom:
    displayName: Wisdom
views:
  - type: parallel-chart
    name: Character stats (parallel)
    xProp: note.Strength, note.Dexterity, note.Constitution, note.Intelligence, note.Wisdom, note.Charisma
    seriesProp: note.Class
    showLegend: true
    filters:
      and:
        - file.folder == "parallel/notes"
        - note.Class != null
