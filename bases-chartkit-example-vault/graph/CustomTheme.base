properties:
  note.Amount:
    displayName: Amount
  note.Source:
    displayName: Source
  note.Target:
    displayName: Target
  note.Zone:
    displayName: Zone
views:
  - type: graph-chart
    name: Network topology (vintage theme)
    sourceProp: note.Source
    targetProp: note.Target
    valueProp: note.Amount
    categoryProp: note.Zone
    showLegend: true
    theme: "Vintage"
    filters:
      and:
        - file.folder == "graph/notes"
