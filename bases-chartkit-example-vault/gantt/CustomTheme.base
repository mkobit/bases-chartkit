properties:
  note.End:
    displayName: End
  note.Phase:
    displayName: Phase
  note.Start:
    displayName: Start
  note.Task:
    displayName: Task
views:
  - type: gantt-chart
    name: Delivery timeline (vintage theme)
    taskProp: note.Task
    startProp: note.Start
    endProp: note.End
    seriesProp: note.Phase
    showLegend: true
    theme: "Vintage"
    filters:
      and:
        - file.folder == "gantt/notes"
