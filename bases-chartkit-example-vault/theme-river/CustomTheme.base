properties:
  note.Date:
    displayName: Date
  note.Mentions:
    displayName: Mentions
  note.Topic:
    displayName: Topic
views:
  - type: theme-river-chart
    name: News topics river (vintage theme)
    xAxisProp: note.Date
    valueProp: note.Mentions
    seriesProp: note.Topic
    showLegend: true
    legendPosition: "bottom"
    theme: "Vintage"
    title: "News topics over time"
    description: "Vintage palette variant of the same date x topic river."
    filters:
      and:
        - file.folder == "theme-river/notes"
