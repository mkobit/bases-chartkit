properties:
  note.Date:
    displayName: Date
  note.Mentions:
    displayName: Mentions
  note.Topic:
    displayName: Topic
views:
  - type: theme-river-chart
    name: News topics river (vertical)
    xAxisProp: note.Date
    valueProp: note.Mentions
    seriesProp: note.Topic
    showLegend: true
    legendPosition: "bottom"
    flipAxis: true
    title: "News topics over time (vertical)"
    description: "Time runs top to bottom; bands spread horizontally."
    filters:
      and:
        - file.folder == "theme-river/notes"
