properties:
  note.Channel:
    displayName: Channel
  note.Product:
    displayName: Product
  note.Score:
    displayName: Score
views:
  - type: boxplot-chart
    name: Product score distribution
    xAxisProp: note.Product
    yAxisProp: note.Score
    showLegend: true
    filters:
      and:
        - file.folder == "boxplot/notes"
  - type: boxplot-chart
    name: Product score distribution by channel
    xAxisProp: note.Product
    yAxisProp: note.Score
    seriesProp: note.Channel
    showLegend: true
    filters:
      and:
        - file.folder == "boxplot/notes"
