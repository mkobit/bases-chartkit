properties:
  note.Change:
    displayName: Change
  note.IsTotal:
    displayName: Is Total
  note.Step:
    displayName: Step
views:
  - type: waterfall-chart
    name: Budget waterfall
    xAxisProp: note.Step
    yAxisProp: note.Change
    totalProp: note.IsTotal
    filters:
      and:
        - file.folder == "waterfall/notes"
